# Built by Cloudflare Pages on push (Jekyll preset). Local preview: `bundle exec jekyll serve`.
source "https://rubygems.org"

gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Ruby 3 no longer bundles the web server that `jekyll serve` uses.
gem "webrick", "~> 1.8"

# Windows has no system time zone database for Ruby to read.
gem "tzinfo-data", platforms: [:mingw, :x64_mingw, :mswin]

# Windows: file-change notifications for `jekyll serve` instead of polling.
gem "wdm", ">= 0.1.0", platforms: [:mingw, :x64_mingw, :mswin]
